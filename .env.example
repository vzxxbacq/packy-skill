# 放到 ~/.config/packy/.env、项目目录 ./.env，或用 PACKY_ENV=/path 指定。不要提交到 git。

# ---- 管理接口鉴权（balance / keys / logs / spend / key * 需要）----
# 控制台 → 个人设置 → 系统访问令牌
PACKY_ACCESS_TOKEN=
# 控制台个人设置里的用户 ID
PACKY_USER_ID=

# ---- 各分组 API key（probe / cheapest 用；分组名大写，- 换 _）----
PACKY_KEY_CC_SALE=
PACKY_KEY_CC_EXPENSIVE=
PACKY_KEY_CODEX_SALE=
PACKY_KEY_CODEX=
PACKY_KEY_DEEPSEEK_SALE=
PACKY_KEY_DEEPSEEK_OFFICIALLY=
PACKY_KEY_GROK_SALE=
PACKY_KEY_GROK_OFFICIALLY=

# ---- 可选 ----
# 平台金额是人民币；换算美元的汇率
CNY_PER_USD=7
# 二次转售加价（0.15 = 15%），price --json 多给 sell_usd_per_m
SELL_MARKUP=0
# 域名，一般不用改
PACKY_ADMIN_BASE=https://www.packyapi.com
PACKY_BASE=https://cf.api.fan
